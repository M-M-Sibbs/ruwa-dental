# --- Database (Neon via Vercel Marketplace, or Supabase) ---
# Leave these out on your own computer to use the built-in local database.
# Pooled connection string, used by the website
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection string, used for migrations. Can be the same as above.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Sessions --- (generate with: openssl rand -base64 32). Required on Vercel.
AUTH_SECRET=""

# Public address of the site, used in links and SEO
NEXT_PUBLIC_SITE_URL="https://ruwadental.co.zw"

# --- WhatsApp Business Cloud API (optional until Meta approves the number) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Number that receives new-booking alerts (defaults to the WhatsApp number in Website CMS)
CLINIC_WHATSAPP_TO="263783397863"
# Name of the approved template (see README). Leave empty to send plain text (testing only).
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# --- First admin login, used once by `npm run db:seed` ---
SEED_ADMIN_EMAIL="admin@ruwadental.co.zw"
SEED_ADMIN_PASSWORD=""
